---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';

const games = [
  {
    title: 'Pokémon Or HeartGold',
    subtitle: 'Pokémon',
    description: 'Appliquez les patchs à votre ROM de Pokémon Or HeartGold en quelques secondes.',
    href: '/pokemon-heartgold',
    accent: '#f2c14e',
    accentDark: '#b8862b',
    tags: ['NDS', 'FR'],
    icon: 'pokeball' as const,
  },
  {
    title: 'Mario Kart DS',
    subtitle: 'Mario Kart',
    description: 'Appliquez les patchs à votre ROM de Mario Kart DS sans rien installer.',
    href: '/mario-kart-ds',
    accent: '#e63946',
    accentDark: '#a4161a',
    tags: ['NDS', 'FR'],
    icon: 'kart' as const,
  },
];

const steps = [
  { n: '01', title: 'Choisissez un jeu', text: 'Sélectionnez le jeu que vous voulez patcher.' },
  { n: '02', title: 'Chargez votre ROM', text: 'Glissez votre fichier .nds. Il ne quitte jamais votre ordinateur.' },
  { n: '03', title: 'Récupérez le résultat', text: 'Le patch est appliqué dans le navigateur. Téléchargez la ROM patchée.' },
];
---

<Layout title="ADL ROM Patcher">
  <header class="nav">
    <a href="/" class="logo">ADL<span>ROM</span></a>
    <nav>
      <a href="#jeux">Jeux</a>
      <a href="#fonctionnement">Fonctionnement</a>
      <a href="/amis">Amis</a>
      <a href="/connexion/">Lier mon jeu</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">▶ Nintendo DS</p>
        <h1>Patchez vos ROMs<br /><span>en un clic.</span></h1>
        <p class="lead">
          Choisissez votre jeu, chargez votre ROM, et c'est fait. Tout se passe dans votre navigateur :
          aucun fichier n'est envoyé sur un serveur.
        </p>
        <a class="btn" href="#jeux">Commencer</a>
      </div>

      <div class="ds" aria-hidden="true">
        <div class="ds-top">
          <div class="speaker"></div>
          <div class="screen screen-top">
            <p class="screen-title">ADL<br />ROM PATCHER</p>
            <p class="blink">PRESS START</p>
          </div>
          <div class="speaker"></div>
        </div>
        <div class="hinge"></div>
        <div class="ds-bottom">
          <div class="dpad"><span></span><span></span></div>
          <div class="screen screen-bottom">
            <div class="touch-btn gold">HeartGold</div>
            <div class="touch-btn red">Mario Kart</div>
          </div>
          <div class="abxy">
            <span>X</span><span>A</span><span>B</span><span>Y</span>
          </div>
        </div>
      </div>
    </section>

    <section id="jeux" class="section">
      <h2>Choisissez un jeu</h2>
      <div class="grid">
        {games.map((game) => <GameCard {...game} />)}
        <div class="soon">
          <p>D'autres jeux<br />bientôt…</p>
        </div>
      </div>
    </section>

    <section id="fonctionnement" class="section">
      <h2>Comment ça marche</h2>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="step-n">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer>
    <p>
      ADL ROM Patcher ne fournit aucune ROM. Utilisez uniquement des copies de jeux que vous possédez.
    </p>
    <p class="small">Pokémon et Mario Kart sont des marques de leurs propriétaires respectifs.</p>
  </footer>
</Layout>

<style>
  .nav,
  main,
  footer {
    width: min(1100px, 100% - 32px);
    margin-inline: auto;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
  }

  .logo {
    font-family: var(--pixel);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .logo span {
    color: var(--gold);
    margin-left: 0.3rem;
  }

  .nav nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .nav nav a {
    text-decoration: none;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.2s;
  }

  .nav nav a:hover {
    color: var(--text);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 3rem;
    padding: 3rem 0 5rem;
  }

  .eyebrow {
    font-family: var(--pixel);
    font-size: 0.7rem;
    color: var(--cyan);
    margin: 0 0 1rem;
  }

  h1 {
    font-size: clamp(1.4rem, 3.4vw, 2.3rem);
    margin: 0 0 1.5rem;
  }

  h1 span {
    color: var(--gold);
    text-shadow: 3px 3px 0 var(--red-dark);
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 2rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--pixel);
    font-size: 0.8rem;
    text-decoration: none;
    color: #1a1300;
    background: var(--gold);
    padding: 1rem 1.6rem;
    border-radius: 10px;
    box-shadow: 0 5px 0 var(--gold-dark);
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }

  .btn:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 var(--gold-dark);
  }

  .btn:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 var(--gold-dark);
  }

  /* Nintendo DS illustration */
  .ds {
    width: min(360px, 100%);
    margin-inline: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.5));
    animation: float 5s ease-in-out infinite;
  }

  .ds-top,
  .ds-bottom {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.2rem 1rem;
    background: linear-gradient(180deg, #3a4170, #262c52);
    border: 2px solid #4b548c;
  }

  .ds-top {
    border-radius: 22px 22px 8px 8px;
  }

  .ds-bottom {
    border-radius: 8px 8px 22px 22px;
  }

  .hinge {
    height: 12px;
    margin: 0 18px;
    background: #1a1f3d;
    border-radius: 4px;
  }

  .screen {
    flex: 1;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    border: 6px solid #10132a;
  }

  .screen-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.12) 0 2px, transparent 2px 4px),
      linear-gradient(160deg, #1b2a6b, #0b1238);
  }

  .screen-title {
    margin: 0;
    font-family: var(--pixel);
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--gold);
    text-shadow: 2px 2px 0 var(--red-dark);
  }

  .blink {
    margin: 0;
    font-family: var(--pixel);
    font-size: 0.5rem;
    color: var(--text);
    animation: blink 1.2s steps(1) infinite;
  }

  .screen-bottom {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem;
    background: #dfe6f5;
  }

  .touch-btn {
    font-family: var(--pixel);
    font-size: 0.45rem;
    text-align: center;
    padding: 0.6rem 0.3rem;
    border-radius: 6px;
    color: #111;
  }

  .touch-btn.gold {
    background: var(--gold);
    box-shadow: 0 3px 0 var(--gold-dark);
  }

  .touch-btn.red {
    background: var(--red);
    color: #fff;
    box-shadow: 0 3px 0 var(--red-dark);
  }

  .speaker {
    width: 18px;
    height: 40px;
    background: radial-gradient(circle, #10132a 1.5px, transparent 2px) 0 0 / 6px 6px;
  }

  .dpad {
    position: relative;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .dpad span {
    position: absolute;
    background: #10132a;
    border-radius: 3px;
  }

  .dpad span:first-child {
    inset: 12px 0;
  }

  .dpad span:last-child {
    inset: 0 12px;
  }

  .abxy {
    display: grid;
    grid-template-areas: '. x .' 'y . a' '. b .';
    grid-template-columns: repeat(3, 12px);
    grid-template-rows: repeat(3, 12px);
    flex-shrink: 0;
  }

  .abxy span {
    display: grid;
    place-items: center;
    font-family: var(--pixel);
    font-size: 0.3rem;
    color: var(--muted);
    background: #10132a;
    border-radius: 50%;
  }

  .abxy span:nth-child(1) { grid-area: x; }
  .abxy span:nth-child(2) { grid-area: a; }
  .abxy span:nth-child(3) { grid-area: b; }
  .abxy span:nth-child(4) { grid-area: y; }

  /* Sections */
  .section {
    padding: 3rem 0;
  }

  h2 {
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    margin: 0 0 2rem;
  }

  h2::before {
    content: '▶ ';
    color: var(--gold);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .soon {
    display: grid;
    place-items: center;
    min-height: 200px;
    border: 2px dashed var(--border);
    border-radius: 18px;
    text-align: center;
  }

  .soon p {
    margin: 0;
    font-family: var(--pixel);
    font-size: 0.65rem;
    line-height: 2;
    color: var(--muted);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: 1.5rem;
    background: var(--bg-alt);
    border: 2px solid var(--border);
    border-radius: 18px;
  }

  .step-n {
    font-family: var(--pixel);
    font-size: 1.4rem;
    color: var(--cyan);
  }

  .steps h3 {
    font-size: 0.75rem;
    margin: 1rem 0 0.5rem;
  }

  .steps p {
    margin: 0;
    color: var(--muted);
  }

  footer {
    margin-top: 3rem;
    padding: 2rem 0 3rem;
    border-top: 2px solid var(--border);
    text-align: center;
    color: var(--muted);
  }

  footer p {
    margin: 0.3rem 0;
  }

  .small {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds,
    .blink {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 1rem;
    }

    .lead {
      margin-inline: auto;
    }

    .ds {
      order: -1;
      width: min(300px, 100%);
    }

    .nav nav {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
